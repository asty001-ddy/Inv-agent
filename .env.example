# Copy to .env for local runs. On Render, put these in the service's Environment tab instead.
# Never commit the real .env file.

PORT=8080
TIMEZONE=Asia/Karachi

# ---------- Groq ----------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Speech-to-text for voice notes (Urdu, English or both)
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# ---------- WhatsApp Agents (recommended) ----------
# In WhatsApp on your phone: Settings > Agents > Create an agent, then open the agent's chat >
# Chat info > API key. The agent can only chat with you (the person who created it).
WHATSAPP_AGENT_TOKEN=
# After a restart, answer messages sent in the last N minutes that were not answered yet
WHATSAPP_AGENT_BACKLOG_MINUTES=10
# Render free plan: the app pings itself every 10 min so it never sleeps. Set to off to disable.
KEEP_AWAKE=on

# ---------- Optional: a WhatsApp Business number (Meta developer app + webhook) ----------
# Only if clients or a team should message a business number. Leave empty otherwise.
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v25.0
# Who may use the business number: international format, no + or spaces. Empty or * = anyone.
ALLOWED_NUMBERS=

# Access key for the web form (your Render URL) and POST /api/invoice. Empty = web access off.
INVOICE_API_KEY=

# ---------- Printed on every invoice ----------
BUSINESS_NAME=Finova Solutions
# Use \n for a new line
BUSINESS_ADDRESS=National Incubation Center\nIslamabad, Pakistan
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_WEBSITE=
BUSINESS_TAX_ID=
BUSINESS_TAX_ID_LABEL=NTN
# Public link to a PNG or JPG logo (optional)
BUSINESS_LOGO_URL=
BANK_DETAILS=Bank: \nAccount title: \nIBAN:
INVOICE_TERMS=Payment is due by the due date. Please quote the invoice number with your payment.
ACCENT_COLOR=#0F4C5C

# ---------- Defaults ----------
CURRENCY=PKR
# Percent. Users can still say "add 16% tax" or "no tax" per invoice.
TAX_RATE=0
TAX_LABEL=Sales tax
DUE_DAYS=7
INVOICE_PREFIX=INV
